# Template de configuration - Copier ce fichier vers .env et remplir les valeurs
# Ce fichier peut être commité sur Git (pas de valeurs sensibles)

# Database Configuration
DB_URL=jdbc:postgresql://localhost:5432/yansnet-db
DB_USERNAME=postgres
DB_PASSWORD=YOUR_DB_PASSWORD_HERE

# Keycloak Configuration
KEYCLOAK_SERVER_URL=http://localhost:8080
KEYCLOAK_REALM=yansnet
KEYCLOAK_ADMIN_CLIENT_ID=admin-cli
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=YOUR_KEYCLOAK_ADMIN_PASSWORD
KEYCLOAK_CLIENT_ID=yansnet-client-test-01
KEYCLOAK_CLIENT_SECRET=YOUR_KEYCLOAK_CLIENT_SECRET

# JWT Issuer (ajuster selon votre configuration Keycloak)
JWT_ISSUER_URI=http://localhost:8080/realms/yansnet
JWT_JWK_SET_URI=http://localhost:8080/realms/yansnet/protocol/openid-connect/certs

# Application
SERVER_PORT=8085
